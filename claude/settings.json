{
  "env": {
    "FORCE_AUTOUPDATE_PLUGINS": "1",
    "REPORT_MODE": "judge",
    "_ZO_DOCTOR": "0",
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/zsh",
    "CLAUDE_SEO_DATA_DIR": "/Users/erik/.claude/plugins/data/claude-seo-agricidaniel-claude-seo"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/asdf-path.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/cc-activity-log.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/cc-activity-log.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/cc-activity-log.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/save-report.sh",
            "timeout": 120,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node /Users/erik/.tokentracker/bin/notify.cjs --source=claude"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node /Users/erik/.tokentracker/bin/notify.cjs --source=claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c '\"/Users/erik/.bun/bin/bun\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)src/index.ts\"'",
    "padding": 0
  },
  "enabledPlugins": {
    "visual-explainer@visual-explainer-marketplace": false,
    "interface-design@interface-design": true,
    "slack@claude-plugins-official": true,
    "vercel-plugin@vercel": false,
